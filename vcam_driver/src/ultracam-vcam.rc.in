// Recursos de la DLL. CMake genera el .rc con la ruta absoluta del icono.
#include <winver.h>
#include "@CMAKE_CURRENT_SOURCE_DIR@/src/resource.h"

IDI_ULTRACAM ICON "@ULTRACAM_ICON@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @ULTRACAM_VERSION_COMMA@
 PRODUCTVERSION @ULTRACAM_VERSION_COMMA@
 FILEFLAGSMASK 0x3fL
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "UltraCam Studio"
            VALUE "FileDescription", "UltraCam virtual camera (DirectShow)"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "ultracam-vcam"
            VALUE "OriginalFilename", "ultracam-vcam@ULTRACAM_ARCH@.dll"
            VALUE "ProductName", "UltraCam Studio"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
